# Keep $PATH unique so re-sourcing across nested/non-interactive shells
# doesn't grow it unbounded ($path/$PATH are tied, so this dedupes both).
typeset -U path

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in every shell -- interactive or not.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# Detect OS once, before any topic file loads, so every path.zsh/env.zsh file
# (and later, zshrc's files) can branch on $DOTFILES_OS (macos | wsl | linux).
# See CLAUDE.md "OS detection".
case "$OSTYPE" in
  darwin*) export DOTFILES_OS=macos ;;
  linux*)
    if grep -qi microsoft /proc/version 2>/dev/null; then
      export DOTFILES_OS=wsl
    else
      export DOTFILES_OS=linux
    fi
    ;;
esac

# PATH and tool env vars -- sourced here (not zshrc) so they're available to
# every shell: interactive, non-interactive, login, or a one-off script/SSH
# command. Interactive-only setup (aliases, prompt, completions) stays in
# zshrc.symlink.
# ponytail: recursive glob runs on every shell startup; fine at this file
# count, revisit with a precomputed file list if non-interactive shells get
# measurably slower.
typeset -U zshenv_files
zshenv_files=($ZSH/**/*.zsh)

for file in ${(M)zshenv_files:#*/path.zsh}
do
  source $file
done

for file in ${(M)zshenv_files:#*/env.zsh}
do
  source $file
done

unset zshenv_files

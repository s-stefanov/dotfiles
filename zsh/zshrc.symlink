# use this for profiling in case the shell becomes slow
export PROFILING_MODE=0
if [ $PROFILING_MODE -ne 0 ]; then
    zmodload zsh/zprof
fi

# your project folder that we can `c [tab]` to
export PROJECTS=~/dev

# $ZSH, $DOTFILES_OS, ~/.localrc, and every path.zsh/env.zsh file are already
# sourced by .zshenv, which zsh reads before .zshrc for every shell -- unless
# ~/.zshenv is missing (new machine, or bootstrap not re-run since the split).
# Without this guard $ZSH is empty and the globs below become /**/*.zsh, which
# walks the entire filesystem. Test with -d, not -n: $ZSH is also oh-my-zsh's.
[[ -d $ZSH/zsh ]] || source "$HOME/.dotfiles/zsh/zshenv.symlink"

# macOS only: /etc/zprofile runs path_helper AFTER .zshenv on every login shell
# (i.e. every Terminal tab), which reorders $PATH so /usr/bin beats anything
# .zshenv set. Re-prepend what .zshenv built; `typeset -U path` dedupes, so
# path_helper's own additions stay at the tail. No-op on non-login shells.
(( $#dotfiles_path )) && path=($dotfiles_path $path)

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load everything but the path, env, and completion files (path.zsh/env.zsh
# already sourced by .zshenv; completion.zsh loads after compinit below)
for file in ${${${config_files:#*/path.zsh}:#*/env.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

if [ $PROFILING_MODE -ne 0 ]; then
    zprof
fi

#!/usr/bin/env bash
# bd-loop-fail <work-id> "<failure-summary>" [--max N]
#
# Retry-then-escalate failure policy for the autonomous loop
# (personal-dev-workflow-zhn, issue 6qk).
#
# On each /stf-implement failure, the loop calls this script. It:
#   1. Appends a structured attempt line to the bead's notes.
#   2. If NEW_COUNT >= MAX, escalates: resets the bead to open, adds a
#      failure-trail comment, and creates a human-labeled blocker bead via
#      bd-ask-human. Returns exit code 1 so the loop moves on.
#   3. Under the limit: records the attempt and returns exit code 0 so the
#      loop schedules a retry.
#
# NOTE FORMAT (appended to notes on each call):
#   [loop-attempt N/MAX] <one-line failure summary>
# Subsequent calls parse the highest N from these lines to determine count.
#
# USAGE:
#   bd-loop-fail <work-id> "<one-line failure summary>" [--max N]
#
# FLAGS:
#   --max N    Max attempts before escalation (default: 2)
#
# OUTPUT (stderr): human-readable progress / escalation info
# EXIT CODES:
#   0   Attempt recorded, under limit (loop should retry the bead)
#   1   Escalated — bead is now blocked, loop should move on
#   2   Usage / argument error

set -euo pipefail

usage() {
  sed -n '2,/^[^#]/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//' | head -30
  exit "${1:-2}"
}

[[ $# -lt 2 ]] && usage 2

WORK_ID="$1"; shift
MAX=2
SUMMARY_PARTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --max)    MAX="${2:?--max needs a value}"; shift 2 ;;
    --help|-h) usage 0 ;;
    *)        SUMMARY_PARTS+=("$1"); shift ;;
  esac
done

SUMMARY="${SUMMARY_PARTS[*]:-}"
[[ -z "$SUMMARY" ]] && { echo "error: failure summary required" >&2; usage 2; }

# Verify work-bead exists
if ! bd show "$WORK_ID" >/dev/null 2>&1; then
  echo "error: work-bead '$WORK_ID' not found" >&2
  exit 2
fi

# Fetch current notes via JSON — more reliable than grepping rendered text
NOTES="$(bd show "$WORK_ID" --json 2>/dev/null \
  | python3 -c "
import json, sys
data = json.load(sys.stdin)
item = data[0] if isinstance(data, list) else data
print(item.get('notes', ''))
" 2>/dev/null || echo "")"

# Parse the highest existing attempt number from [loop-attempt N/...] lines
PREV_COUNT="$(echo "$NOTES" \
  | grep -oE '\[loop-attempt [0-9]+/' \
  | grep -oE '[0-9]+' \
  | sort -n | tail -1 \
  || true)"
NEW_COUNT=$(( ${PREV_COUNT:-0} + 1 ))

NOTE_LINE="[loop-attempt $NEW_COUNT/$MAX] $SUMMARY"
bd update "$WORK_ID" --append-notes "$NOTE_LINE" >/dev/null

echo "Recorded: $NOTE_LINE" >&2

if [[ "$NEW_COUNT" -ge "$MAX" ]]; then
  # Collect all attempt lines for the failure-trail comment
  EXISTING_ATTEMPTS="$(echo "$NOTES" | grep '\[loop-attempt' || true)"
  if [[ -n "$EXISTING_ATTEMPTS" ]]; then
    TRAIL="${EXISTING_ATTEMPTS}"$'\n'"${NOTE_LINE}"
  else
    TRAIL="$NOTE_LINE"
  fi

  # Reset work-bead to open (un-claim) so it re-enters ready once unblocked
  bd update "$WORK_ID" --status open >/dev/null

  # Final comment on the work-bead with full trail (human sees history inline)
  bd comment "$WORK_ID" "[bd-loop-fail] Escalating after $MAX failures. Failure trail:
${TRAIL}

A human-labeled blocker bead has been created. Remove the blocker to re-enable
this bead, or close it if the work is no longer relevant." >/dev/null

  # Create blocker question-bead (same bd-ask-human pattern as 458)
  ESCALATION_MSG="Automatic escalation: '$WORK_ID' failed $MAX consecutive times. Review failure trail in the work-bead's notes/comments, fix the root cause, then dismiss this blocker to re-enable the work."

  Q_ID="$(bd-ask-human "$WORK_ID" "$ESCALATION_MSG")"

  echo "Escalated: created blocker $Q_ID. Work-bead '$WORK_ID' is now blocked and excluded from ready-picker." >&2
  exit 1
fi

exit 0

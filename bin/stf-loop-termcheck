#!/usr/bin/env bash
# stf-loop-termcheck <epic-id>
#
# Termination check for the /stf-loop autonomous driver (epic: zhn).
# Run once per loop pass BEFORE dispatching the next /stf-implement.
#
# Traverses all transitive descendants of <epic-id> via BFS, partitions
# open/in_progress beads by the 'human' label, and returns a structured
# exit decision. Decision is driven entirely by bd state — the agent
# cannot influence the result by claiming done without updating bd.
# (AC6: verified by reading bd, not agent output.)
#
# DECISION VALUES:
#   continue         Non-human work remains; loop should dispatch next item.
#   complete         No open/in_progress descendants (human or otherwise).
#   waiting-on-human All remaining open work is human-labeled; loop parks.
#   circuit-breaker  Never returned by this script. Reserved for the loop
#                    wrapper (54x/84v) to overlay on top of this output.
#
# OUTPUT (stdout): JSON object with fields:
#   decision      — one of the values above
#   epic_id       — epic queried
#   remaining     — count of non-human open/in_progress descendants
#   human_pending — count of human-labeled open/in_progress descendants
#   detail        — human-readable summary
#   human_ids     — array of human-labeled bead IDs (populated when waiting)
#   remaining_ids — array of non-human open/in_progress bead IDs
#   ts            — ISO-8601 timestamp (UTC)
#
# EXIT CODES:
#   0  — continue
#   10 — complete
#   11 — waiting-on-human
#   2  — usage or bd error
#
# OBSERVABILITY (stderr, one line per invocation):
#   [stf-loop-termcheck] <ts> epic=<id> remaining=<n> human_pending=<n> => <decision>
#
# USAGE:
#   stf-loop-termcheck personal-dev-workflow-zhn
#   DECISION=$(stf-loop-termcheck personal-dev-workflow-zhn | python3 -c "import sys,json; print(json.load(sys.stdin)['decision'])")

set -euo pipefail

EPIC_ID="${1:-}"
if [[ -z "$EPIC_ID" ]]; then
  echo "usage: stf-loop-termcheck <epic-id>" >&2
  exit 2
fi

if ! bd show "$EPIC_ID" >/dev/null 2>&1; then
  echo "error: bead '$EPIC_ID' not found" >&2
  exit 2
fi

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# BFS across all transitive descendants, then query bd for status+label
# bd children --json gives direct children only (no --recursive flag),
# so we iterate level by level. bd list --id with server-side label
# filters gives accurate counts without loading labels into Python.
set +e
RESULT=$(EPIC_ID="$EPIC_ID" TS="$TS" python3 << 'PYEOF'
import subprocess, json, sys, os

epic_id = os.environ["EPIC_ID"]
ts = os.environ["TS"]


def bd(*args):
    """Run a bd subcommand, return parsed JSON. Returns [] on error."""
    try:
        out = subprocess.check_output(["bd", *args], stderr=subprocess.DEVNULL)
        return json.loads(out)
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return []


def get_children_ids(bead_id):
    data = bd("children", bead_id, "--json")
    return [i["id"] for i in data if isinstance(i, dict) and "id" in i]


def bd_list_ids(ids, status, label_flag, label_value):
    """Return IDs from bd list --id <ids> --status <s> [--label/--exclude-label] <v>."""
    if not ids:
        return []
    id_str = ",".join(ids)
    args = ["list", "--id", id_str, "--status", status, "--limit", "0", "--json",
            label_flag, label_value]
    data = bd(*args)
    if not isinstance(data, list):
        return []
    return [i["id"] for i in data if isinstance(i, dict) and "id" in i]


# BFS to collect all transitive descendant IDs (excluding the epic itself)
queue = [epic_id]
visited = set([epic_id])
all_descendant_ids = []

while queue:
    node_id = queue.pop(0)
    children = get_children_ids(node_id)
    for cid in children:
        if cid not in visited:
            visited.add(cid)
            all_descendant_ids.append(cid)
            queue.append(cid)

if not all_descendant_ids:
    # Epic has no descendants at all — treat as complete
    result = {
        "decision": "complete",
        "epic_id": epic_id,
        "remaining": 0,
        "human_pending": 0,
        "detail": "epic complete (no descendants)",
        "human_ids": [],
        "remaining_ids": [],
        "ts": ts,
    }
    print(json.dumps(result))
    sys.exit(10)

# Query bd for the two partitions using server-side label filters
remaining_ids = bd_list_ids(
    all_descendant_ids, "open,in_progress",
    "--exclude-label", "human"
)
human_ids = bd_list_ids(
    all_descendant_ids, "open,in_progress",
    "--label", "human"
)

remaining = len(remaining_ids)
human_pending = len(human_ids)

if remaining > 0:
    decision = "continue"
    detail = f"{remaining} non-human work item{'s' if remaining != 1 else ''} remain"
    exit_code = 0
elif human_pending > 0:
    decision = "waiting-on-human"
    detail = f"waiting on human ({human_pending} pending)"
    exit_code = 11
else:
    decision = "complete"
    detail = "epic complete"
    exit_code = 10

result = {
    "decision": decision,
    "epic_id": epic_id,
    "remaining": remaining,
    "human_pending": human_pending,
    "detail": detail,
    "human_ids": human_ids,
    "remaining_ids": remaining_ids,
    "ts": ts,
}
print(json.dumps(result))
sys.exit(exit_code)
PYEOF
)
EXIT_CODE=$?
set -e

# AC7: observability — one structured log line per invocation
DECISION=$(echo "$RESULT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['decision'])" 2>/dev/null || echo "error")
REMAINING=$(echo "$RESULT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['remaining'])" 2>/dev/null || echo "?")
HUMAN_PENDING=$(echo "$RESULT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['human_pending'])" 2>/dev/null || echo "?")

echo "[stf-loop-termcheck] $TS epic=$EPIC_ID remaining=$REMAINING human_pending=$HUMAN_PENDING => $DECISION" >&2

echo "$RESULT"
exit "$EXIT_CODE"
